# Optional local settings. Copy to .env to change them. Nothing here is secret.
OLLAMA_BASE_URL=http://localhost:11434
# Chat model: writes answers. Must be a chat model, never an embedding model.
OLLAMA_CHAT_MODEL=llama3.2
# Embedding model: turns text into vectors. Used only for embeddings.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Where PDFs, vectors and chat history are stored.
DATA_DIR=./data
# Longest time (seconds) one lesson run or answer may take.
RUN_TIMEOUT_SECONDS=240
# Below this similarity the chatbot answers "not found" without calling the model.
MIN_SIMILARITY=0.35
